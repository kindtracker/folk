{
  "manifest_version": 3,
  "name": "Folk",
  "version": "1.0.0",
  "description": "Folk is an old Roblox-style web client designed to run Vortex on every device.",
  "host_permissions": [
    "http://127.0.0.1:6969/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.playvortex.io/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
